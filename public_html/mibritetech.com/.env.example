# MiBriTech Environment Configuration

# IP Tracker API Key - used by home server to update its IP
# Generate a secure random key: openssl rand -hex 32
IP_TRACKER_API_KEY=your-secret-api-key-here

# Database (if needed later)
DB_HOST=localhost
DB_NAME=mibritech
DB_USER=mibritech
DB_PASS=localdev

# Environment
APP_ENV=development
APP_DEBUG=true
